# Use a pooled Postgres connection with TLS, supplied by your database provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Generate a private random 64-character key; never put it in the Windows app.
FLYGUY_ADMIN_KEY=
# OpenAI model ID with text output and Responses API support.
OPENAI_MODEL=
# Server-side OpenAI API key. Never put this in the desktop app or owner console.
OPENAI_API_KEY=
